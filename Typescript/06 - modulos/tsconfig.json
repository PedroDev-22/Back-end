{
  "compilerOptions": {
    // Módulos
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    // Pastas
    "rootDir": "./exercicios",
    "outDir": "./dist",
    // Outputs
    "sourceMap": true,
    // Strict
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Importante para módulos
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "exercicios/**/*"
  ]
}